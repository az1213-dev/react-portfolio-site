# ==============================================================================
# REACT PORTFOLIO SITE - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to `.env` and populate it with your local/deployment values.
#
# IMPORTANT:
# Never store private API secrets or credentials in REACT_APP_* variables,
# as they will be publicly exposed in the compiled client-side JavaScript.
# ==============================================================================

# Contact Form Submission Endpoint (Formspree)
# The REACT_APP_ prefix is mandatory — Create React App strips every other
# variable from the browser bundle. This must also be set in your host's
# environment variables (e.g. the Vercel project settings), because .env is
# gitignored and never reaches the build server.
REACT_APP_FORMSPREE_ENDPOINT=https://formspree.io/f/your_formspree_id

# Public Portfolio Base URL
REACT_APP_SITE_URL=https://az1213-dev.github.io/react-portfolio-site

# Optional Public Analytics Tracking ID
# REACT_APP_GA_TRACKING_ID=G-XXXXXXXXXX

